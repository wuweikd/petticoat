generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum ItemCategory {
  skirt
  top
  outer
  accessory
  foundation
  footwear
}

enum Cut {
  JSK
  OP
  SK
  Blouse
  Cardigan
  Coat
  Cape
  Headdress
  Hairbow
  Wristcuff
  Bag
  Pannier
  Shoes
  Socks
  Other
}

enum BaseColor {
  black
  white
  red
  pink
  blue
  green
  purple
  brown
  yellow
  multicolor
  other
}

enum WardrobeStatus {
  wishlist
  on_order
  owned
}

enum Substyle {
  sweet
  gothic
  classic
  punk
  other
}

enum ReminderKind {
  manual_release
  release_from_post
  other
}

enum PostType {
  outfit
  tutorial
  official
  encyclopedia
  brand_release
}

enum PostStatus {
  draft
  published
  hidden
}

/// 衣橱对外可见粒度（P2）
enum WardrobeVisibility {
  private
  followers
  public
}

model User {
  id                 String    @id @default(cuid())
  phone              String?   @unique
  nickname           String
  bio                String?
  avatarUri          String?
  yearsInLolita      Int?
  preferredSubstyles Substyle[]
  favoriteBrandIds   String[]
  reduceMotion       Boolean   @default(false)
  /// 默认仅自己可见；followers=关注者可见非私密条目；public=游客可见非私密
  wardrobeVisibility WardrobeVisibility @default(private)
  role               UserRole  @default(USER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdItems    Item[]           @relation("ItemCreator")
  wardrobeEntries WardrobeEntry[]
  reminders       CalendarReminder[]
  posts           Post[]
  coordinates     Coordinate[]
  following       Follow[]         @relation("UserFollowing")
  followers       Follow[]         @relation("UserFollowers")
}

/// 关注关系
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
}

model Item {
  id              String       @id @default(cuid())
  brandId         String
  name            String
  category        ItemCategory
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  brand     Brand     @relation(fields: [brandId], references: [id])
  createdBy User      @relation("ItemCreator", fields: [createdByUserId], references: [id])
  variants  Variant[]

  @@index([brandId])
  @@index([name])
}

model Variant {
  id              String    @id @default(cuid())
  itemId          String
  colorName       String
  baseColor       BaseColor
  cut             Cut
  catalogImageUri String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  item            Item             @relation(fields: [itemId], references: [id])
  wardrobeEntries WardrobeEntry[]
  postVariants    PostVariant[]
  coordinateSlots CoordinateSlot[]

  @@unique([itemId, colorName, cut])
  @@index([itemId])
}

model WardrobeEntry {
  id            String         @id @default(cuid())
  userId        String
  variantId     String
  status        WardrobeStatus
  size          String?
  quantity      Int            @default(1)
  private       Boolean        @default(false)
  /// 隐藏预订/尾款进度（对外展示时仅显示想要/已拥有等粗状态）
  hidePreorder  Boolean        @default(false)
  note          String?
  userImageUris String[]
  /// 想要同款来源帖（可空）
  sourcePostId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  variant   Variant          @relation(fields: [variantId], references: [id])
  preorders PreorderRecord[]

  @@unique([userId, variantId])
  @@index([userId, status])
  @@index([sourcePostId])
}

model PreorderRecord {
  id               String    @id @default(cuid())
  wardrobeEntryId  String
  depositAmountCny Decimal   @db.Decimal(12, 2)
  depositPaidAt    DateTime?
  balanceAmountCny Decimal   @db.Decimal(12, 2)
  balanceDueAt     DateTime  @db.Date
  balancePaid      Boolean   @default(false)
  balancePaidAt    DateTime?
  expectedArrivalAt DateTime? @db.Date
  cancelled        Boolean   @default(false)
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wardrobeEntry WardrobeEntry @relation(fields: [wardrobeEntryId], references: [id])

  @@index([wardrobeEntryId])
  @@index([balanceDueAt])
}

model CalendarReminder {
  id        String       @id @default(cuid())
  userId    String
  title     String
  at        DateTime
  kind      ReminderKind @default(manual_release)
  sourcePostId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, at])
}

enum SlotKind {
  main
  extra
}

/// ADR-0007：搭配位置主键为 VariantId；主坑 + 额外槽
model Coordinate {
  id        String   @id @default(cuid())
  ownerId   String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User             @relation(fields: [ownerId], references: [id])
  slots  CoordinateSlot[]
  posts  Post[]

  @@index([ownerId])
}

model CoordinateSlot {
  id           String        @id @default(cuid())
  coordinateId String
  kind         SlotKind
  /// 主坑必填且与 Item.category 匹配；额外槽为 accessory / foundation
  category     ItemCategory?
  variantId    String
  sortOrder    Int           @default(0)

  coordinate Coordinate @relation(fields: [coordinateId], references: [id], onDelete: Cascade)
  variant    Variant    @relation(fields: [variantId], references: [id])

  @@index([coordinateId])
  @@index([variantId])
}

/// Phase 1 CMS can create posts even if App feed is Phase 2
model Post {
  id           String     @id @default(cuid())
  authorId     String
  type         PostType
  status       PostStatus @default(draft)
  title        String
  body         String?
  coverUri     String?
  /// 图集（含封面）；coverUri 与 imageUris[0] 保持同步便于旧客户端
  imageUris    String[]   @default([])
  releaseAt    DateTime?  @db.Date
  coordinateId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publishedAt  DateTime?

  author     User         @relation(fields: [authorId], references: [id])
  coordinate Coordinate?  @relation(fields: [coordinateId], references: [id], onDelete: SetNull)
  variants   PostVariant[]

  @@index([type, status])
  @@index([authorId])
  @@index([coordinateId])
}

model PostVariant {
  postId    String
  variantId String
  sortOrder Int    @default(0)

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])

  @@id([postId, variantId])
}
